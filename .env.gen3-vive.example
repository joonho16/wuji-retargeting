# Copy to .env or export these before docker compose commands if you want
# non-default values. docker-compose.gen3-vive.yml also has safe defaults.
ROS_DISTRO=humble
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Must match the Windows VIVE sender UDP port.
VIVE_UDP_PORT=9000
# Optional serial pinning. Leave empty unless you want to reject all other trackers.
# VIVE_EXPECTED_SERIAL=LHR-XXXXXXXX

# Dry-run/default wrapper config.
GEN3_VIVE_CALIBRATION=example/config/gen3_vive_dry_run_calibration.yaml
GEN3_VIVE_TWIST_TOPIC=/gen3_vive/debug_twist
GEN3_VIVE_STATUS_TOPIC=/gen3_vive/status
GEN3_VIVE_PHYSICAL_DEADMAN_TOPIC=/gen3_vive/physical_deadman
