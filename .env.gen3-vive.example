# Copy to .env or export these before docker compose commands if you want
# non-default values. docker-compose.gen3-vive.yml also has safe defaults.
ROS_DISTRO=humble
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Must match the Windows VIVE sender UDP port.
VIVE_UDP_PORT=9000
# Optional serial pinning. Leave empty unless you want to reject all other trackers.
# VIVE_EXPECTED_SERIAL=LHR-XXXXXXXX

# Dry-run/default wrapper config.
GEN3_VIVE_CALIBRATION=example/config/gen3_vive_dry_run_calibration.yaml
GEN3_VIVE_CALIBRATION_DIR=./example/config
GEN3_VIVE_TWIST_TOPIC=/servo_node/delta_twist_cmds
GEN3_VIVE_STATUS_TOPIC=/gen3_vive/status
GEN3_VIVE_PHYSICAL_DEADMAN_TOPIC=/gen3_vive/physical_deadman

# Gen3 MoveIt Servo stack. full-fake uses fake hardware; full-real requires
# GEN3_ROBOT_IP and a reviewed calibration/deadman path.
GEN3_ROBOT_IP=0.0.0.0
GEN3_DOF=7
GEN3_GRIPPER=robotiq_2f_85
GEN3_GRIPPER_JOINT_NAME=robotiq_85_left_knuckle_joint
GEN3_SERVO_CONFIG=example/config/gen3_vive_moveit_servo.yaml
GEN3_SERVO_START_DELAY_S=8.0
GEN3_SERVO_AUTOSTART=true
GEN3_VIVE_DEADMAN_DELAY_S=5
