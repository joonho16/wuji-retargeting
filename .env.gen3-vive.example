# Copy to .env or export these before docker compose commands if you want
# non-default values. docker-compose.gen3-vive.yml also has safe defaults.
ROS_DISTRO=humble
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Must match the Windows VIVE sender UDP port.
VIVE_UDP_PORT=9000
# Optional serial pinning. Leave empty unless you want to reject all other trackers.
# VIVE_EXPECTED_SERIAL=LHR-XXXXXXXX

# Dry-run/default wrapper config. These are not valid for real-robot mode.
GEN3_VIVE_CALIBRATION=example/config/gen3_vive_dry_run_calibration.yaml
GEN3_VIVE_CALIBRATION_DIR=./example/config
# For real-robot mode, first run scripts/gen3_vive_init_real_calib.sh, edit the
# generated .local/gen3_vive_calib/real_gen3_vive_calibration.yaml, set
# real_robot_calibration_reviewed: true inside that YAML, then override:
# GEN3_VIVE_CALIBRATION_DIR=.local/gen3_vive_calib
# GEN3_VIVE_CALIBRATION=/calib/real_gen3_vive_calibration.yaml
# Leave unset for the profile default: native /twist_controller/commands on
# full-real, Servo /servo_node/delta_twist_cmds on legacy fake profiles.
# GEN3_VIVE_TWIST_TOPIC=/twist_controller/commands
GEN3_VIVE_STATUS_TOPIC=/gen3_vive/status
GEN3_VIVE_PHYSICAL_DEADMAN_TOPIC=/gen3_vive/physical_deadman
# Mapper command smoothing. 1.0 disables smoothing; lower values reduce
# stationary VIVE/TF buzz but add lag. Prefer calibration deadbands first.
GEN3_VIVE_LOW_PASS_ALPHA=1.0

# full-real uses native Twist; full-fake retains the Servo simulation. Real mode requires
# GEN3_ROBOT_IP and a reviewed calibration/deadman path.
GEN3_ROBOT_IP=0.0.0.0
GEN3_DOF=7
GEN3_GRIPPER=robotiq_2f_85
GEN3_GRIPPER_JOINT_NAME=robotiq_85_left_knuckle_joint
GEN3_SERVO_CONFIG=example/config/gen3_vive_moveit_servo.yaml
GEN3_JOINT_LIMITS_CONFIG=example/config/gen3_joint_limits.yaml
# For editable caps without rebuilding, copy the YAML into the host calibration
# directory and set GEN3_JOINT_LIMITS_CONFIG=/calib/gen3_joint_limits.yaml.
# The legacy Servo launcher queries robot limits before launching. Timeout includes
# connection, reads and cleanup. These credentials are for the read-only query.
GEN3_LIMIT_QUERY_TIMEOUT_S=15.0
# GEN3_LIMIT_QUERY_USERNAME=admin
# GEN3_LIMIT_QUERY_PASSWORD=admin
GEN3_SERVO_START_DELAY_S=8.0
GEN3_SERVO_AUTOSTART=true
GEN3_VIVE_DEADMAN_DELAY_S=5
