# Copy to .env.gen3-manus for local operator defaults. Do not commit .env.gen3-manus.
HAND=left
MANUS_PORT=15020
MANUS_UDP_HOST=127.0.0.1
MANUS_UDP_PORT=15020
MANUS_HOST=0.0.0.0
# MANUS_CORE_IP=192.168.50.132
# GEN3_ROBOT_IP=192.168.50.10
GEN3_VIVE_CALIBRATION_DIR=.local/gen3_vive_calib
GEN3_VIVE_CALIBRATION=/calib/real_gen3_vive_calibration.yaml
# Focused A/B hold window: A teleop, B saved action + open hand; release stops.
GEN3_HOME_ACTION=ready
# GEN3_OPERATOR_DIR=.local/gen3_operator
# full-real automatically sets GEN3_OPERATOR_STATE=/operator/intent.json for WH110.
# full-real uses native Twist. Set linear_scale/angular_scale and Cartesian
# speed caps in the reviewed calibration YAML. Joint limit settings below apply
# only to the legacy Servo launcher.
# Optional per-joint velocity/acceleration caps: copy example/config/gen3_joint_limits.yaml
# into GEN3_VIVE_CALIBRATION_DIR, edit it, and uncomment this path.
# GEN3_JOINT_LIMITS_CONFIG=/calib/gen3_joint_limits.yaml
# GEN3_LIMIT_QUERY_USERNAME=admin
# GEN3_LIMIT_QUERY_PASSWORD=admin
# CONFIRM_REAL_WH110=I_UNDERSTAND_WH110_MOVES
